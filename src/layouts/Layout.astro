---
interface Props {
	title?: string;
}
const { title = 'Giacomo Boehlke — Editor' } = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="/swiss-international.css" />
		<title>{title}</title>
		<!-- Apply the saved / preferred theme before paint to avoid a flash. -->
		<script is:inline>
			(() => {
				const saved = localStorage.getItem('gb.theme');
				const dark = saved
					? saved === 'dark'
					: window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (dark) document.documentElement.dataset.theme = 'dark';
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	body {
		margin: 0;
	}
	/* Smooth in-page scrolling, unless the user prefers reduced motion. */
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>
